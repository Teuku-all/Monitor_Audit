# Backend runtime configuration
PORT=3001
JWT_SECRET=replace-with-a-random-secret-at-least-20-characters
SESSION_HOURS=4
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_EMAIL=admin@audit.com
ADMIN_PASSWORD=choose-a-strong-password
ALLOW_BEARER_TOKENS=false
ALLOW_PUBLIC_REGISTRATION=false
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_API_KEY=your-restricted-google-drive-api-key
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Frontend build-time configuration (Vite exposes only VITE_* values to browser code)
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_ALLOW_REGISTRATION=false
# Optional; currently unused by the app.
VITE_UPLOADS_URL=
